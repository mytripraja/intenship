# ============================================
# ACTIVE SMS PROVIDER
# Options: firebase | fast2sms | twilio | msg91 | messagecentral
# ============================================
ACTIVE_SMS_PROVIDER=firebase

# ============================================
# Firebase Client Config
# ============================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ============================================
# Firebase Admin SDK (for custom token minting)
# ============================================
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ============================================
# Fast2SMS (https://www.fast2sms.com)
# ============================================
FAST2SMS_API_KEY=your_fast2sms_api_key

# ============================================
# Twilio (https://www.twilio.com)
# ============================================
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ============================================
# MSG91 (https://msg91.com)
# ============================================
MSG91_API_KEY=your_msg91_api_key
MSG91_TEMPLATE_ID=your_template_id

# ============================================
# Message Central (https://console.messagecentral.com)
# ============================================
MC_CUSTOMER_ID=your_customer_id
MC_PASSWORD=your_message_central_password
